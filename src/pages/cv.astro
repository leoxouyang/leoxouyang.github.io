        text: {
          zh: "评估学生反馈与学习结果，持续改进课程内容、沟通方法和参与策略。",
          en: "Evaluated student feedback and learning outcomes to refine course content, communication methods, and engagement strategies.",
        },
      },
    ],
  },
];

const research = [
