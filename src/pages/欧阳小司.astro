---
import LanguageToggle from "../components/LanguageToggle.astro";

const posts = Object.values(
    import.meta.glob("./posts/*.md", { eager: true }),
) as Array<{
    url: string;
    frontmatter: {
        title: string;
        date: string;
        description?: string;
    };
}>;
const name = "欧阳小司的博客";

// Sort posts by date, newest first
posts.sort(
    (a, b) =>
        new Date(b.frontmatter.date).valueOf() -
        new Date(a.frontmatter.date).valueOf(),
);
---

<html lang="zh-CN" data-lang="zh">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/images/site-logo.png" />
        <title>{name}</title>
    </head>

    <body>
        {/* 顶部导航栏 */}
        <header class="topbar">
            <div class="topbar-inner">
                <a class="brand" href="/">
                    <img
                        class="brand-logo"
                        src="/images/site-logo.png"
                        alt="Zhenghao Lu"
                        width="40"
                        height="40"
                    />
                </a>
                <div class="topbar-actions">
                    <nav class="nav">
                        <a href="/ZhenghaoLu-CV.pdf">Resume</a>
                        <a
                            href="https://www.linkedin.com/in/zhenghao-lu-a6a396372/"
                            rel="noreferrer">LinkedIn</a
                        >
                        <a href="/#projects">Projects</a>
                        <a href="/research">Research</a>
                        <a href="/欧阳小司" style="opacity: 1; font-weight: 600;">
                            <span data-lang="zh">欧阳小司的博客</span>
                            <span data-lang="en">Thoughts</span>
                        </a>
                    </nav>
                    <LanguageToggle />
                </div>
            </div>
        </header>

        <main class="container">
            <h1 data-lang="zh">文章列表</h1>
            <h1 data-lang="en">Thoughts</h1>
            <ul class="post-list">
                {
                    posts.map((post) => (
                        <li>
                            <a href={post.url} class="post-link">
                                <span class="post-title">
                                    {post.frontmatter.title}
                                </span>
                                <span class="post-date">
                                    {post.frontmatter.date}
                                </span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </main>

        <style>
            /* 全局样式 */
            :global(*),
            :global(*::before),
            :global(*::after) {
                box-sizing: border-box;
            }

            :global(html, body) {
                min-height: 100%;
                width: 100%;
                margin: 0;
                background: #fff;
                font-family:
                    system-ui,
                    -apple-system,
                    BlinkMacSystemFont,
                    "Segoe UI",
                    Roboto,
                    sans-serif;
            }

            /* 顶栏 */
            .topbar {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                background: #fff;
                border-bottom: 1px solid #eee;
                z-index: 100;
            }
            .topbar-inner {
                width: 100%;
                padding: 12px clamp(18px, 4vw, 48px);
                display: flex;
                align-items: center;
                justify-content: space-between;
            }
            .brand {
                display: inline-flex;
                align-items: center;
                text-decoration: none;
                color: #111;
                opacity: 1;
            }
            .brand-logo {
                display: block;
                width: 40px;
                height: 40px;
                object-fit: contain;
            }
            .nav {
                display: flex;
                gap: 16px;
                align-items: center;
            }
            .nav a {
                text-decoration: none;
                color: #111;
                font-size: 14px;
                opacity: 0.75;
                line-height: 1;
                display: flex;
                align-items: center;
            }
            .nav a:hover {
                opacity: 1;
            }

            /* 主要内容区域 */
            .container {
                max-width: 700px;
                margin: 0 auto;
                padding: 96px 24px 48px; /* 顶部留出导航栏空间 */
            }

            h1 {
                font-size: 24px;
                margin-bottom: 32px;
                font-weight: 600;
            }

            .post-list {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .post-list li {
                margin-bottom: 16px;
                border-bottom: 1px solid #f5f5f5;
                padding-bottom: 16px;
            }

            .post-list li:last-child {
                border-bottom: none;
            }

            .post-link {
                display: flex;
                justify-content: space-between;
                align-items: center;
                text-decoration: none;
                color: #333;
                transition: color 0.2s;
            }

            .post-link:hover {
                color: #000;
            }

            .post-link:hover .post-title {
                text-decoration: underline;
            }

            .post-title {
                font-size: 16px;
                font-weight: 500;
            }

            .post-date {
                font-size: 14px;
                color: #888;
                font-feature-settings: "tnum";
            }
        </style>
    </body>
</html>
