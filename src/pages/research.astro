---
import LanguageToggle from "../components/LanguageToggle.astro";

const name = "Zhenghao Lu";
const email = "zhenghao_lu@outlook.com";
const resumePdf = "/ZhenghaoLu-CV.pdf";
const linkedinUrl = "https://www.linkedin.com/in/zhenghao-lu-a6a396372/";

const researchItems = [
  {
    title: "Daily Hope, Exam Stress, and Adolescent Well-Being",
    titleZh: "每日希望、考试压力与青少年幸福感",
    status: "In Progress",
    methods: "Daily diary study, multilevel modeling, longitudinal analysis",
    methodsZh: "日记研究、多层模型、纵向分析",
    summary:
      "This project used a 7-day diary design to understand how adolescents experience stress, motivation, and emotional change during exam week. By tracking students' daily hope, exam stress, psychological needs, and affect, the study identified when stress becomes most harmful and what internal resources help students stay resilient. The project reflects my interest in studying people's lived experiences over time and turning repeated-measure data into actionable insights about support needs.",
    summaryZh:
      "这个项目使用 7 天日记研究设计，理解青少年在考试周如何经历压力、动机和情绪变化。研究追踪学生每日的希望感、考试压力、心理需求与情绪状态，识别压力在什么时候最具伤害性，以及哪些内部资源帮助学生保持韧性。这个项目体现了我对真实生活经验和重复测量数据的兴趣。",
    keywords:
      "Adolescent well-being, hope, exam stress, daily diary, need satisfaction",
    keywordsZh: "青少年幸福感、希望、考试压力、日记研究、需求满足",
    images: [
      {
        src: "/images/research/daily-hope/model-overview.png",
        alt: "Conceptual model for the daily hope, exam stress, and well-being study",
        caption: "Conceptual model",
        captionZh: "研究模型图",
      },
      {
        src: "/images/research/daily-hope/daily-trends.png",
        alt: "Daily mean trends of key variables across 7 days",
        caption: "Daily trends across exam week",
        captionZh: "考试周关键变量的日均趋势",
      },
      {
        src: "/images/research/daily-hope/gender-positive-affect.png",
        alt: "Gender moderation of the effect of hope on positive affect",
        caption: "Gender moderation: positive affect",
        captionZh: "性别调节：积极情绪",
      },
      {
        src: "/images/research/daily-hope/gender-negative-affect.png",
        alt: "Gender moderation of the effect of hope on negative affect",
        caption: "Gender moderation: negative affect",
        captionZh: "性别调节：消极情绪",
      },
      {
        src: "/images/research/daily-hope/three-way-positive-affect.png",
        alt: "Three-way interaction among hope, stress, and need satisfaction predicting positive affect",
        caption: "Hope x stress x need satisfaction: positive affect",
        captionZh: "希望 x 压力 x 需求满足：积极情绪",
      },
      {
        src: "/images/research/daily-hope/three-way-negative-affect.png",
        alt: "Three-way interaction among hope, stress, and need satisfaction predicting negative affect",
        caption: "Hope x stress x need satisfaction: negative affect",
        captionZh: "希望 x 压力 x 需求满足：消极情绪",
      },
    ],
  },
  {
    title: "Parenting, Social Anxiety, Internet Use, and Adolescent Well-Being",
    titleZh: "父母教养方式、社交焦虑、网络使用与青少年幸福感",
    status: "In Progress",
    methods:
      "Survey research, structural equation modeling, mediation analysis",
    methodsZh: "问卷研究、结构方程模型、中介分析",
    summary:
      "This study examined how family environments relate to adolescents' psychological well-being through social anxiety and problematic Internet use. Using survey data from 981 students, the project separated positive and negative parenting patterns and compared paternal and maternal models. Rather than treating well-being as a single outcome, the analysis mapped the pathways through which social context, emotional experience, and digital behavior shape adolescent adjustment.",
    summaryZh:
      "这项研究考察家庭环境如何通过社交焦虑和问题性网络使用影响青少年的心理幸福感。研究基于 981 名学生的问卷数据，区分积极和消极教养方式，并比较父亲与母亲模型。分析没有把幸福感视为单一结果，而是梳理社会情境、情绪经验与数字行为如何共同影响青少年适应。",
    keywords:
      "Parenting styles, psychological well-being, social anxiety, Internet addiction, adolescents",
    keywordsZh: "教养方式、心理幸福感、社交焦虑、网络成瘾、青少年",
    images: [
      {
        src: "/images/research/parenting/model-pathways.png",
        alt: "Hypothesized model linking parenting styles, social anxiety, Internet addiction, and psychological well-being",
        caption: "Hypothesized pathway model",
        captionZh: "假设路径模型",
      },
    ],
  },
  {
    title: "Psychosocial Resources and Burnout Among Female Preschool Teachers",
    titleZh: "女性幼儿教师的心理社会资源与职业倦怠",
    status: "In Progress",
    methods: "Latent profile analysis, segmentation, outcome comparison",
    methodsZh: "潜在剖面分析、群体分层、结果比较",
    summary:
      "This project used latent profile analysis to segment female preschool teachers based on workplace climate, social well-being, and hope. The study identified four distinct resource profiles and compared their burnout patterns, showing that more resources do not automatically translate into lower burnout. For user research, this project demonstrates my interest in segmentation, group-level behavior patterns, and the importance of avoiding one-size-fits-all explanations when designing support systems.",
    summaryZh:
      "这个项目使用潜在剖面分析，根据工作场所氛围、社会幸福感和希望感对女性幼儿教师进行群体分层。研究识别出四类资源画像，并比较其职业倦怠模式，说明资源更多并不一定自动带来更低倦怠。它也对应我在用户研究中的兴趣：理解群体差异、行为模式，并避免用单一解释设计支持系统。",
    keywords:
      "Teacher burnout, organizational climate, hope, social well-being, latent profile analysis",
    keywordsZh: "教师倦怠、组织氛围、希望感、社会幸福感、潜在剖面分析",
    images: [
      {
        src: "/images/research/burnout/resource-profiles.png",
        alt: "Latent profile patterns of psychosocial resources among female preschool teachers",
        caption: "Psychosocial resource profiles",
        captionZh: "心理社会资源剖面",
      },
    ],
  },
];
---

<html lang="zh-CN" data-lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/site-logo.png" />
    <title>Research | {name}</title>
  </head>

  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/">
          <img
            class="brand-logo"
            src="/images/site-logo.png"
            alt={name}
            width="40"
            height="40"
          />
        </a>
        <div class="topbar-actions">
          <nav class="nav">
            <a href={resumePdf}>Resume</a>
            <a href={linkedinUrl} rel="noreferrer">LinkedIn</a>
            <a href="/ux">UX</a>
            <a href="/research">Research</a>
            <a href="/欧阳小司">
              <span data-lang="zh">欧阳小司的博客</span>
              <span data-lang="en">Thoughts</span>
            </a>
          </nav>
          <LanguageToggle />
        </div>
      </div>
    </header>

    <main>
      <section class="intro">
        <div class="section-inner">
          <p class="eyebrow">
            <span data-lang="zh">Research</span>
            <span data-lang="en">Research</span>
          </p>
          <h1 data-lang="zh">行为研究</h1>
          <h1 data-lang="en">Research on Human Behavior</h1>
          <p class="lead" data-lang="zh">
            我的研究关注人在真实生活情境中如何经历压力、支持和幸福感。在青少年心理健康与教师职业倦怠相关项目中，我使用问卷、日记研究和统计建模方法识别行为模式、心理需求与群体差异。这些项目也延伸到我对用户研究的兴趣：深入理解人，才能设计更好的系统、服务和支持体验。
          </p>
          <p class="lead" data-lang="en">
            My research focuses on how people experience stress, support,
            motivation, and well-being in real-life contexts. Across adolescent
            mental health and teacher burnout projects, I use survey, diary, and
            statistical modeling methods to identify behavioral patterns,
            psychological needs, and group differences. These projects inform my
            broader interest in user research: understanding people deeply
            enough to design better systems, services, and support experiences.
          </p>
        </div>
      </section>

      <section class="section">
        <div class="section-inner research-list">
          {
            researchItems.map((item) => (
              <article
                class={`research-item ${item.images ? "research-item-gallery" : ""}`}
              >
                {item.images ? (
                  <div
                    class="research-gallery"
                    aria-label={`${item.title} figures`}
                  >
                    {item.images.map((image) => (
                      <figure>
                        <img src={image.src} alt={image.alt} loading="lazy" />
                        <figcaption>
                          <span data-lang="zh">{image.captionZh}</span>
                          <span data-lang="en">{image.caption}</span>
                        </figcaption>
                      </figure>
                    ))}
                  </div>
                ) : (
                  <div
                    class="image-slot"
                    aria-label={`${item.title} image area`}
                  >
                    <span data-lang="zh">图片区域</span>
                    <span data-lang="en">Image area</span>
                  </div>
                )}
                <div class="research-copy">
                  <p class="status">
                    <span data-lang="zh">{item.statusZh}</span>
                    <span data-lang="en">{item.status}</span>
                  </p>
                  <h2>
                    <span data-lang="zh">{item.titleZh}</span>
                    <span data-lang="en">{item.title}</span>
                  </h2>
                  <dl class="meta">
                    <div>
                      <dt>
                        <span data-lang="zh">方法</span>
                        <span data-lang="en">Methods</span>
                      </dt>
                      <dd>
                        <span data-lang="zh">{item.methodsZh}</span>
                        <span data-lang="en">{item.methods}</span>
                      </dd>
                    </div>
                    <div>
                      <dt>
                        <span data-lang="zh">关键词</span>
                        <span data-lang="en">Keywords</span>
                      </dt>
                      <dd>
                        <span data-lang="zh">{item.keywordsZh}</span>
                        <span data-lang="en">{item.keywords}</span>
                      </dd>
                    </div>
                  </dl>
                  <p data-lang="zh">{item.summaryZh}</p>
                  <p data-lang="en">{item.summary}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="section-inner">
        <a href={`mailto:${email}`}>{email}</a>
      </div>
    </footer>

    <style>
      :global(*),
      :global(*::before),
      :global(*::after) {
        box-sizing: border-box;
      }

      :global(html, body) {
        min-height: 100%;
        width: 100%;
        margin: 0;
        background: #fff;
        color: #111;
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          sans-serif;
      }

      .topbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background: #fff;
        border-bottom: 1px solid #eee;
        z-index: 100;
      }

      .topbar-inner {
        width: 100%;
        padding: 12px clamp(18px, 4vw, 48px);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        color: #111;
        opacity: 1;
      }

      .brand-logo {
        display: block;
        width: 40px;
        height: 40px;
        object-fit: contain;
      }

      .nav {
        display: flex;
        gap: 16px;
        align-items: center;
      }

      .nav a {
        text-decoration: none;
        color: #111;
        font-size: 14px;
        opacity: 0.75;
        line-height: 1;
        display: flex;
        align-items: center;
      }

      .nav a:hover {
        opacity: 1;
      }

      .intro {
        padding: 136px 0 72px;
        border-bottom: 1px solid #f1f1f1;
      }

      .section {
        padding: 72px 0 88px;
      }

      .section-inner {
        width: 80%;
        max-width: none;
        margin: 0 auto;
      }

      .eyebrow {
        margin: 0 0 12px;
        color: #777;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      h1,
      h2 {
        margin: 0;
        color: #111;
        font-weight: 600;
        line-height: 1.25;
        letter-spacing: 0;
      }

      h1 {
        max-width: none;
        font-size: 34px;
      }

      h2 {
        font-size: 22px;
      }

      .lead {
        max-width: none;
        margin: 22px 0 0;
        color: #444;
        font-size: 16px;
        line-height: 1.75;
      }

      .research-list {
        display: grid;
        gap: 42px;
      }

      .research-item {
        display: grid;
        grid-template-columns: minmax(220px, 320px) minmax(0, 1fr);
        gap: 32px;
        align-items: start;
        padding-bottom: 42px;
        border-bottom: 1px solid #eee;
      }

      .research-item:last-child {
        padding-bottom: 0;
        border-bottom: 0;
      }

      .research-item-gallery {
        grid-template-columns: 1fr;
        gap: 24px;
      }

      .image-slot {
        aspect-ratio: 4 / 3;
        width: 100%;
        display: grid;
        place-items: center;
        border: 1px solid #e3e3e3;
        background:
          linear-gradient(135deg, #fafafa 25%, transparent 25%) -12px 0 / 24px
            24px,
          linear-gradient(225deg, #fafafa 25%, transparent 25%) -12px 0 / 24px
            24px,
          linear-gradient(315deg, #fafafa 25%, transparent 25%) 0 0 / 24px 24px,
          linear-gradient(45deg, #fafafa 25%, #fff 25%) 0 0 / 24px 24px;
        color: #888;
        font-size: 13px;
      }

      .research-gallery {
        order: 2;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
      }

      .research-gallery figure {
        margin: 0;
        border: 1px solid #e8e8e8;
        background: #fff;
      }

      .research-gallery img {
        display: block;
        width: 100%;
        height: clamp(120px, 15vw, 168px);
        padding: 8px;
        object-fit: contain;
      }

      .research-gallery figcaption {
        min-height: 42px;
        padding: 8px 10px 10px;
        border-top: 1px solid #eee;
        color: #666;
        font-size: 12px;
        line-height: 1.45;
      }

      .research-item-gallery .research-copy {
        order: 1;
      }

      .research-copy {
        color: #444;
        font-size: 15px;
        line-height: 1.75;
      }

      .research-copy p {
        margin: 18px 0 0;
      }

      .status {
        margin: 0 0 10px;
        color: #777;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .meta {
        display: grid;
        gap: 8px;
        margin: 18px 0 0;
      }

      .meta div {
        display: grid;
        grid-template-columns: 84px minmax(0, 1fr);
        gap: 14px;
      }

      .meta dt {
        color: #777;
        font-size: 13px;
        font-weight: 600;
      }

      .meta dd {
        margin: 0;
        color: #444;
      }

      .footer {
        padding: 28px 0 48px;
        border-top: 1px solid #f1f1f1;
      }

      .footer a {
        color: #555;
        font-size: 14px;
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      @media (max-width: 720px) {
        .topbar-inner {
          align-items: flex-start;
          gap: 12px;
          padding: 12px 18px;
        }

        .nav {
          justify-content: flex-end;
          flex-wrap: wrap;
          gap: 10px 14px;
        }

        .nav a {
          font-size: 13px;
        }

        .intro {
          padding: 120px 0 56px;
        }

        .section {
          padding: 56px 0 72px;
        }

        h1 {
          font-size: 28px;
        }

        h2 {
          font-size: 20px;
        }

        .research-item {
          grid-template-columns: 1fr;
          gap: 20px;
        }

        .research-gallery {
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: 10px;
        }

        .research-gallery img {
          height: 112px;
          padding: 6px;
        }

        .research-gallery figcaption {
          min-height: 38px;
          padding: 7px 8px 8px;
          font-size: 11px;
        }

        .meta div {
          grid-template-columns: 1fr;
          gap: 2px;
        }
      }

      @media (max-width: 520px) {
        .research-gallery {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
    </style>
  </body>
</html>
