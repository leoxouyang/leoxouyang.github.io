---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found | Zhenghao Lu"
  description="This page does not exist."
  noindex
>
  <main class="not-found">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p>页面不存在，可能已经移动或删除。The page may have moved or been removed.</p>
    <div class="links">
      <a href="/">Home</a>
      <a href="/portfolio">Portfolio</a>
      <a href="/cv">CV</a>
    </div>
  </main>
</Layout>

<style>
  .not-found {
    min-height: 100vh;
    display: grid;
    place-content: center;
    gap: 16px;
    padding: 96px 24px;
    color: #111;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
    text-align: center;
  }

  .eyebrow {
    margin: 0;
    color: #777;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;
    font-size: 30px;
    font-weight: 600;
  }

  p {
    margin: 0;
    color: #555;
    line-height: 1.7;
  }

  .links {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 12px;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 14px;
    border: 1px solid #ddd;
    color: #111;
    font-size: 14px;
    text-decoration: none;
  }

  .links a:hover {
    border-color: #111;
  }
</style>
