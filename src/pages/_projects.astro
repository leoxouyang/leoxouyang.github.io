---
import LanguageToggle from "../components/LanguageToggle.astro";

const name = "Zhenghao Lu";
const email = "zhenghao_lu@outlook.com";
const resumePdf = "/ZhenghaoLu-CV.pdf";
const linkedinUrl = "https://www.linkedin.com/in/zhenghao-lu-a6a396372/";

const projectItems = [
  {
    title: "Portfolio Case Study",
    titleZh: "作品集案例",
    status: "Placeholder",
    statusZh: "占位内容",
    summary:
      "A future project entry can summarize the problem, process, role, tools, and outcome. This placeholder keeps the section structured without inventing finished project details.",
    summaryZh:
      "未来的项目条目可以展示问题、过程、角色、工具和结果。这里先用占位内容保留结构，避免编造尚未整理好的项目细节。",
  },
  {
    title: "Data and Research Tool",
    titleZh: "数据与研究工具",
    status: "Placeholder",
    statusZh: "占位内容",
    summary:
      "This slot can later show an analytical workflow, dashboard, automation, or research support tool, with screenshots and measurable outcomes.",
    summaryZh:
      "这一栏之后可以放分析流程、仪表盘、自动化工具或研究支持工具，并补充截图和可衡量结果。",
  },
  {
    title: "Product Experiment",
    titleZh: "产品实验",
    status: "Placeholder",
    statusZh: "占位内容",
    summary:
      "This placeholder is reserved for a product or UX experiment, including the hypothesis, iteration notes, and what changed after testing.",
    summaryZh:
      "这里预留给产品或用户体验实验，可以记录假设、迭代过程，以及测试后发生了什么变化。",
  },
];
---

<html lang="zh-CN" data-lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/site-logo.png" />
    <title>Projects | {name}</title>
  </head>

  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/">
          <img
            class="brand-logo"
            src="/images/site-logo.png"
            alt={name}
            width="40"
            height="40"
          />
        </a>
        <div class="topbar-actions">
          <nav class="nav">
            <a href={resumePdf}>CV</a>
            <a href={linkedinUrl} rel="noreferrer">LinkedIn</a>
            <a href="/projects">
              <span data-lang="zh">项目</span>
              <span data-lang="en">Projects</span>
            </a>
            <a href="/research">
              <span data-lang="zh">研究</span>
              <span data-lang="en">Research</span>
            </a>
            <a href="/欧阳小司">
              <span data-lang="zh">欧阳小司的博客</span>
              <span data-lang="en">Thoughts</span>
            </a>
          </nav>
          <LanguageToggle />
        </div>
      </div>
    </header>

    <main>
      <section class="intro">
        <div class="section-inner">
          <p class="eyebrow">Projects</p>
          <h1 data-lang="zh">项目与实验</h1>
          <h1 data-lang="en">Projects and Experiments</h1>
          <p class="lead" data-lang="zh">
            这里会逐步整理我做过的项目、工具和实验。当前先用占位内容保留结构，之后可以补充截图、背景、方法、角色和结果。
          </p>
          <p class="lead" data-lang="en">
            This page will collect projects, tools, and experiments over time.
            For now, it uses placeholders so the structure is ready for future
            screenshots, context, methods, roles, and outcomes.
          </p>
        </div>
      </section>

      <section class="section">
        <div class="section-inner project-list">
          {
            projectItems.map((item) => (
              <article class="project-item">
                <div class="image-slot" aria-label={`${item.title} image area`}>
                  <span data-lang="zh">图片区域</span>
                  <span data-lang="en">Image area</span>
                </div>
                <div class="project-copy">
                  <p class="status">
                    <span data-lang="zh">{item.statusZh}</span>
                    <span data-lang="en">{item.status}</span>
                  </p>
                  <h2>
                    <span data-lang="zh">{item.titleZh}</span>
                    <span data-lang="en">{item.title}</span>
                  </h2>
                  <p data-lang="zh">{item.summaryZh}</p>
                  <p data-lang="en">{item.summary}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="section-inner">
        <a href={`mailto:${email}`}>{email}</a>
      </div>
    </footer>

    <style>
      :global(*),
      :global(*::before),
      :global(*::after) {
        box-sizing: border-box;
      }

      :global(html, body) {
        min-height: 100%;
        width: 100%;
        margin: 0;
        background: #fff;
        color: #111;
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          sans-serif;
      }

      .topbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background: #fff;
        border-bottom: 1px solid #eee;
        z-index: 100;
      }

      .topbar-inner {
        width: 100%;
        padding: 12px clamp(18px, 4vw, 48px);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        color: #111;
        opacity: 1;
      }

      .brand-logo {
        display: block;
        width: 40px;
        height: 40px;
        object-fit: contain;
      }

      .nav {
        display: flex;
        gap: 16px;
        align-items: center;
      }

      .nav a {
        text-decoration: none;
        color: #111;
        font-size: 14px;
        opacity: 0.75;
        line-height: 1;
        display: flex;
        align-items: center;
      }

      .nav a:hover {
        opacity: 1;
      }

      .intro {
        padding: 136px 0 72px;
        border-bottom: 1px solid #f1f1f1;
      }

      .section {
        padding: 72px 0 88px;
      }

      .section-inner {
        width: 80%;
        max-width: none;
        margin: 0 auto;
      }

      .eyebrow {
        margin: 0 0 12px;
        color: #777;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      h1,
      h2 {
        margin: 0;
        color: #111;
        font-weight: 600;
        line-height: 1.25;
        letter-spacing: 0;
      }

      h1 {
        max-width: none;
        font-size: 34px;
      }

      h2 {
        font-size: 22px;
      }

      .lead {
        max-width: none;
        margin: 22px 0 0;
        color: #444;
        font-size: 16px;
        line-height: 1.75;
      }

      .project-list {
        display: grid;
        gap: 42px;
      }

      .project-item {
        display: grid;
        grid-template-columns: minmax(220px, 320px) minmax(0, 1fr);
        gap: 32px;
        align-items: start;
        padding-bottom: 42px;
        border-bottom: 1px solid #eee;
      }

      .project-item:last-child {
        padding-bottom: 0;
        border-bottom: 0;
      }

      .image-slot {
        aspect-ratio: 4 / 3;
        width: 100%;
        display: grid;
        place-items: center;
        border: 1px solid #e3e3e3;
        background:
          linear-gradient(135deg, #fafafa 25%, transparent 25%) -12px 0 / 24px
            24px,
          linear-gradient(225deg, #fafafa 25%, transparent 25%) -12px 0 / 24px
            24px,
          linear-gradient(315deg, #fafafa 25%, transparent 25%) 0 0 / 24px 24px,
          linear-gradient(45deg, #fafafa 25%, #fff 25%) 0 0 / 24px 24px;
        color: #888;
        font-size: 13px;
      }

      .project-copy {
        color: #444;
        font-size: 15px;
        line-height: 1.75;
      }

      .project-copy p {
        margin: 18px 0 0;
      }

      .status {
        margin: 0 0 10px;
        color: #777;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .footer {
        padding: 28px 0 48px;
        border-top: 1px solid #f1f1f1;
      }

      .footer a {
        color: #555;
        font-size: 14px;
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      @media (max-width: 720px) {
        .topbar-inner {
          align-items: flex-start;
          gap: 12px;
          padding: 12px 18px;
        }

        .nav {
          justify-content: flex-end;
          flex-wrap: wrap;
          gap: 10px 14px;
        }

        .nav a {
          font-size: 13px;
        }

        .intro {
          padding: 120px 0 56px;
        }

        .section {
          padding: 56px 0 72px;
        }

        h1 {
          font-size: 28px;
        }

        h2 {
          font-size: 20px;
        }

        .project-item {
          grid-template-columns: 1fr;
          gap: 20px;
        }
      }
    </style>
  </body>
</html>
