const resumePdf = "/ZhenghaoLu-CV.pdf";
const linkedinUrl = "https://www.linkedin.com/in/zhenghao-lu-a6a396372/";

const case1Figures = [
  {
    title: "Conceptual model",
    src: "/images/research/daily-hope/model-overview.png",
    alt: "Within-person mediation model, moderation model, and lagged model for hope, exam stress, psychological need satisfaction, and affect.",
    featured: true,
  },
  {
    title: "Daily trends across exam week",
    src: "/images/research/daily-hope/daily-trends.png",
    alt: "Daily mean trends of key variables across the seven-day exam week.",
  },
  {
    title: "Hope x stress x need satisfaction: negative affect",
    src: "/images/research/daily-hope/three-way-negative-affect.png",
    alt: "Three-way interaction plot showing exam stress and need satisfaction effects on negative affect across low and high hope levels.",
  },
  {
    title: "Hope x stress x need satisfaction: positive affect",
    src: "/images/research/daily-hope/three-way-positive-affect.png",
    alt: "Three-way interaction plot showing exam stress and need satisfaction effects on positive affect across low and high hope levels.",
