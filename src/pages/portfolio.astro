      "Survey research",
      "Structural equation modeling",
      "Mediation analysis",
      "Paternal and maternal model comparison",
      "Pathway visualization and interpretation",
    ],
    overview: [
      "981 adolescent participants",
      "Multi-scale survey dataset",
      "Positive and negative parenting patterns",
      "Psychological well-being and digital behavior outcomes",
    ],
    questions: [
      "How are positive and negative parenting patterns associated with adolescent well-being?",
      "Do social anxiety and problematic Internet use help explain these relationships?",
      "How do paternal and maternal pathways differ?",
    ],
    process: [
      {
        title: "Construct Mapping",
        text: "Structured the relationships among parenting patterns, social anxiety, Internet use, and psychological well-being.",
      },
      {
        title: "Model Comparison",
        text: "Separated positive and negative parenting patterns and compared paternal and maternal models.",
      },
      {
        title: "Pathway Analysis",
        text: "Used mediation and structural equation modeling to examine direct and indirect relationships.",
      },
      {
        title: "Insight Synthesis",
        text: "Translated a complex set of pathways into a clear account of how social context, emotion, and digital behavior interact.",
      },
    ],
    insights: [
      {
        title: "Family context works through multiple pathways.",
        text: "Parenting patterns may relate to well-being both directly and through adolescents' emotional and digital experiences.",
      },
      {
        title: "Positive and negative patterns should be examined separately.",
        text: "Combining them into one overall score can hide meaningful differences in how family experiences relate to adjustment.",
      },
      {
        title: "Complex systems need clear visual explanation.",
        text: "A pathway model can make multi-step relationships easier to interpret without reducing them to a single cause.",
      },
    ],
    figures: [
      {
        title: "Hypothesized pathway model",
        src: "/images/research/parenting/model-pathways.png",
