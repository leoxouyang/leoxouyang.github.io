const cases = [
  {
    label: "Case 1",
    title:
      "Case 1: Understanding Daily Emotional Experiences in High School Students",
    subtitle:
      "A 7-day diary study on subjective well-being, hope, academic stress, and daily need satisfaction.",
    context:
      "High school students' well-being is not static. Their emotional experiences may fluctuate from day to day depending on academic stress, hope, and psychological need satisfaction. This project aimed to understand these daily dynamics using a longitudinal diary design.",
    status: "In Progress",
    role: "Co-Principal Investigator",
    methods: [
      "7-day diary study",
      "Repeated-measures data cleaning",
      "Within-person and between-person decomposition",
      "Multilevel modeling in R",
      "Data visualization and result interpretation",
    ],
    overview: [
      "292 valid participants",
      "1,752 daily observations",
      "7 consecutive diary waves",
      "Repeated-measures psychological data",
    ],
    questions: [
      "How do students' well-being and emotional experiences fluctuate across days?",
      "How are daily hope and academic stress associated with daily well-being?",
      "How can we distinguish within-person changes from between-person differences?",
    ],
    process: [
      {
        title: "Data Preparation",
        text: "Screened and cleaned repeated-measures data to ensure accuracy, completeness, and consistency.",
      },
      {
        title: "Data Structuring",
        text: "Organized diary data into an analysis-ready format suitable for daily-level modeling.",
      },
      {
        title: "Statistical Modeling",
        text: "Conducted multilevel modeling in R to distinguish within-person fluctuations from between-person differences.",
      },
      {
        title: "Research Communication",
        text: "Contributed to result interpretation, visualization, and manuscript preparation.",
      },
    ],
    insights: [
      {
        title:
          "Student well-being should be understood as a dynamic daily experience, not only as a stable trait.",
        text: "Students may experience meaningful day-to-day changes in emotional states, which suggests the importance of tracking experiences over time rather than relying only on one-time measurements.",
      },
      {
        title: "Hope may function as a daily psychological resource.",
        text: "Daily hope can help explain why students feel better on some days than others, highlighting the value of psychological resources in stressful academic contexts.",
      },
      {
        title:
          "Academic stress needs to be interpreted at both individual and daily levels.",
        text: "Some students may generally experience higher stress than others, while the same student may also experience unusually stressful days. These two patterns require different interpretations.",
      },
    ],
    figures: case1Figures,
  },
  {
    label: "Case 2",
    title:
      "Case 2: Latent Profiles of Job Burnout among Female Kindergarten Teachers",
    subtitle: "A person-centered research case using latent profile analysis.",
    context:
      "Burnout is not experienced in the same way by all teachers. Instead of assuming a single average pattern, this project used a person-centered approach to identify distinct burnout profiles among female kindergarten teachers.",
    status: "In Progress",
    role: "Co-Principal Investigator",
    methods: [
      "Behavioral research",
      "Latent profile analysis in R",
      "Model comparison using fit indices",
      "Post-profile comparison",
      "Data visualization",
    ],
    overview: [
      "713 female kindergarten teachers",
      "Multi-scale survey dataset",
      "Burnout indicators and psychological resource variables",
      "Person-centered profile analysis",
    ],
    questions: [
      "Are there distinct burnout profiles among female kindergarten teachers?",
      "How do these profiles differ across burnout dimensions and related variables?",
      "How can statistical profiles be translated into meaningful group-level insights?",
    ],
    segments: [
      {
        title: "High-Organizational Support Group",
        resource:
          "High organizational climate resources, but comparatively lower social well-being and trait hope.",
        interpretation:
          "These teachers may work in a relatively supportive organizational environment, but their internal psychological and social resources are not equally strong.",
      },
      {
        title: "High-Resource Group",
        resource:
          "High levels across organizational climate, social well-being, and trait hope.",
        interpretation:
          "These teachers appear resource-rich across both workplace and personal domains. However, the manuscript shows that this group reported the highest levels of burnout across emotional exhaustion, depersonalization, and reduced personal accomplishment.",
      },
      {
        title: "Low-Resource Group",
        resource:
          "Lower organizational climate, social well-being, and trait hope.",
        interpretation:
          "This group showed limited psychosocial resources across both external and internal domains. Interestingly, the manuscript reports that this group had relatively lower burnout levels than expected.",
      },
