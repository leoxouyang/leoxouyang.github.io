            <a href={resumePdf}>Resume</a>
            <a href={linkedinUrl} rel="noreferrer">LinkedIn</a>
            <a class="active" href="/portfolio">Portfolio</a>
            <a href="/欧阳小司">
              <span data-lang="zh">欧阳小司的博客</span>
              <span data-lang="en">Thoughts</span>
            </a>
          </nav>
          <LanguageToggle />
        </div>
      </div>
    </header>

    <main>
      <section class="intro">
        <div class="section-inner">
          <p class="eyebrow">Portfolio</p>
          <h1>Behavioral Research Portfolio</h1>
          <p class="lead">
            This work sample demonstrates my ability to understand human
            experiences through mixed behavioral research methods and translate
            complex data into actionable insights.
          </p>
          <dl class="overview">
            <div>
              <dt>Name</dt>
              <dd>Zhenghao Lu</dd>
            </div>
            <div>
              <dt>Focus</dt>
              <dd>Psychology Researcher | Data Analysis</dd>
            </div>
            <div>
              <dt>Featured Cases</dt>
              <dd>
                Adolescent well-being, teacher burnout profiles, and family
                pathways to psychological well-being.
              </dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="section">
        <div class="section-inner">
          <p class="eyebrow">About Me</p>
          <div class="about-grid">
            <div>
              <h2>
                Psychology-trained researcher with human-centered methods
              </h2>
            </div>
            <div class="copy">
              <p>
                I am a psychology-trained researcher with experience in
                longitudinal behavioral research, survey-based studies,
                statistical modeling, and research communication.
              </p>
              <p>
                My work focuses on understanding human needs, emotional
                experiences, and behavioral patterns through structured research
                methods.
