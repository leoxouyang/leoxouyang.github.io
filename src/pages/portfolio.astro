    title: "Research Design",
    text: "I can translate human experience questions into structured research designs.",
  },
  {
    title: "Longitudinal Thinking",
    text: "I can analyze how experiences change over time rather than relying only on one-time measurements.",
  },
  {
    title: "Quantitative Research Capability",
    text: "I can clean, structure, analyze, and visualize complex behavioral datasets.",
  },
  {
    title: "Segmentation Mindset",
    text: "I can identify meaningful subgroups and translate statistical patterns into human-centered insights.",
  },
  {
    title: "Insight Communication",
    text: "I can turn complex research findings into clear, actionable narratives for non-specialist audiences.",
  },
];

const mappingRows = [
  {
    practice: "Diary Study",
    capability: "Tracking experience over time",
    application:
      "Diary studies, onboarding research, retention experience tracking",
  },
  {
    practice: "Daily emotional fluctuation",
    capability: "Understanding changing user states",
    application:
      "Identifying how users' needs, emotions, and pain points evolve across contexts",
  },
  {
    practice: "Within-person analysis",
    capability: "Context-sensitive behavior analysis",
    application:
      "Understanding how the same user behaves differently under different situations",
  },
  {
    practice: "Between-person differences",
    capability: "Individual difference thinking",
    application:
      "User segmentation and identifying different experience patterns",
  },
  {
    practice: "Multilevel modeling",
    capability: "Analyzing nested behavioral data",
    application:
      "Interpreting repeated user data, session-level data, or longitudinal feedback",
  },
