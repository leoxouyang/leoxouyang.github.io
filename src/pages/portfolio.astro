                  <dl>
                    <div>
                      <dt>My Role</dt>
                      <dd>{item.role}</dd>
                    </div>
                    <div>
                      <dt>Status</dt>
                      <dd>{item.status}</dd>
                    </div>
                    <div>
                      <dt>Research Overview</dt>
                      <dd>
                        <ul>
                          {item.overview.map((entry) => (
                            <li>{entry}</li>
                          ))}
                        </ul>
                      </dd>
                    </div>
                    <div>
                      <dt>Methods</dt>
                      <dd>
                        <ul>
                          {item.methods.map((entry) => (
                            <li>{entry}</li>
                          ))}
                        </ul>
                      </dd>
