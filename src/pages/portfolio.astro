                    </article>
                  )}

                  {"figures" in item && (
                    <article class="content-block">
                      <div class="figure-heading">
                        <div>
                          <p class="block-label">Selected Figures</p>
                          <h3>Research visuals</h3>
                        </div>
                        <p>
                          Visual summaries of the study model and its central
                          analytical findings.
                        </p>
                      </div>
                      <div
                        class="case-figure-gallery drag-scroll-track"
                        data-drag-scroll
                        tabindex="0"
                        aria-label={`${item.label} figures`}
                      >
                        {item.figures.map((figure) => (
                          <figure class={figure.featured ? "featured" : ""}>
                            <img
                              src={figure.src}
                              alt={figure.alt}
                              loading="eager"
                            />
                            <figcaption>{figure.title}</figcaption>
                          </figure>
                        ))}
                      </div>
                    </article>
                  )}

                  <article class="content-block">
                    <p class="block-label">Key Insights</p>
                    <div class="insight-list">
                      {item.insights.map((insight, index) => (
                        <section>
                          <span>Insight {index + 1}</span>
                          <h3>{insight.title}</h3>
                          <p>{insight.text}</p>
                        </section>
                      ))}
                    </div>
                    {"portfolioNote" in item && (
                      <p class="portfolio-note">{item.portfolioNote}</p>
                    )}
                  </article>
                </div>
              </div>
            </div>
          </section>
        ))
      }

      <section class="section">
        <div class="section-inner">
          <div class="section-heading">
            <div>
              <p class="eyebrow">What These Cases Demonstrate</p>
              <h2>Research capabilities across contexts</h2>
            </div>
            <p>
              Together, these projects show how my psychology background
              supports research that requires curiosity, empathy, analytical
              rigor, and clear communication.
            </p>
          </div>

          <div class="capability-grid">
            {
              capabilities.map((capability, index) => (
                <section>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <h3>{capability.title}</h3>
                  <p>{capability.text}</p>
                </section>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section final-section">
        <div class="section-inner">
          <p class="eyebrow">Methods in Practice</p>
          <h2>Transferable research methods and applications</h2>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Academic Research Practice</th>
                  <th>Core Research Capability</th>
                  <th>Practical Application</th>
                </tr>
              </thead>
              <tbody>
                {
                  mappingRows.map((row) => (
                    <tr>
                      <td>{row.practice}</td>
                      <td>{row.capability}</td>
                      <td>{row.application}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="section-inner">
        <a href={`mailto:${email}`}>{email}</a>
      </div>
    </footer>

    <script is:inline>
      (() => {
        document.querySelectorAll("[data-drag-scroll]").forEach((track) => {
          let isDragging = false;
          let startX = 0;
          let startScrollLeft = 0;

          const stopDragging = () => {
            isDragging = false;
            track.classList.remove("is-dragging");
          };

          track.addEventListener("pointerdown", (event) => {
            if (event.pointerType === "mouse" && event.button !== 0) return;

            isDragging = true;
            startX = event.clientX;
            startScrollLeft = track.scrollLeft;
            track.classList.add("is-dragging");
            track.setPointerCapture?.(event.pointerId);
          });

          track.addEventListener("pointermove", (event) => {
            if (!isDragging) return;

            event.preventDefault();
            track.scrollLeft = startScrollLeft - (event.clientX - startX);
          });

          track.addEventListener("pointerup", stopDragging);
          track.addEventListener("pointercancel", stopDragging);
          track.addEventListener("pointerleave", stopDragging);
        });
      })();
    </script>

    <style>
